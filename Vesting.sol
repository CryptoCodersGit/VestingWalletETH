    ============================================================
                    Crypto Coders - Solidity Tutorial
    ============================================================

   title: Vesting Wallet
    Author: Crypto Coders

    درباره این پروژه:
    در این آموزش قصد داریم یک قرارداد هوشمند Vesting Wallet
    را با زبان Solidity از صفر پیاده‌سازی کنیم.

    Vesting چیست؟
    Vesting به معنای آزادسازی تدریجی دارایی در یک بازه زمانی
    مشخص است. این روش در پروژه‌های بلاکچینی برای پرداخت حقوق،
    پاداش اعضای تیم، سهم بنیان‌گذاران و سرمایه‌گذاران استفاده
    می‌شود.

    سناریوی این پروژه:
    فرض کنید یک شرکت می‌خواهد 12 واحد ETH را به یکی از اعضای
    تیم خود اختصاص دهد؛ اما نمی‌خواهد تمام دارایی را یک‌جا
    در اختیار او قرار دهد.

    بنابراین ETH داخل یک قرارداد هوشمند قفل می‌شود و طبق
    یک برنامه زمانی مشخص، به‌تدریج برای دریافت‌کننده آزاد
    خواهد شد.

    امکانات قرارداد:
    1. دریافت ETH هنگام Deploy قرارداد
    2. تعیین مالک و دریافت‌کننده دارایی
    3. تعیین زمان شروع آزادسازی
    4. تعیین مدت زمان Cliff
    5. آزادسازی خطی دارایی در طول زمان
    6. برداشت دارایی آزادشده توسط دریافت‌کننده
    7. امکان لغو Vesting توسط مالک
    8. بازگرداندن بخش آزاد‌نشده به مالک

    هدف آموزش:
    آشنایی عملی با مدیریت دارایی، محاسبات زمانی،
    شرط‌ها، توابع، Modifierها، Eventها و انتقال امن ETH
    در قراردادهای هوشمند.

    توجه:
    این قرارداد یک نمونه آموزشی است و پیش از استفاده با
    سرمایه واقعی باید به‌طور کامل تست و حسابرسی امنیتی شود.

    ============================================================
*/

// SPDX-License-Identifier: MIT

pragma solidity ^0.8.24;

contract VestingWallet {

    // =====================================================
    // 1. متغیرهای اصلی قرارداد
    // =====================================================

    // آدرس مالک قرارداد؛ شخصی که قرارداد را Deploy می‌کند
    address public owner;

    // آدرس دریافت‌کننده ETH
    address public user;

    // زمان شروع Vesting
    // این مقدار بر اساس Unix Timestamp و بر حسب ثانیه است
    uint256 public start;

    // مدت زمان Cliff بر حسب ثانیه
    // قبل از پایان این مدت، امکان برداشت وجود ندارد
    uint256 public cliff;

    // کل مدت زمان Vesting بر حسب ثانیه
    uint256 public duration;

    // کل مقدار ETH اختصاص داده‌شده به دریافت‌کننده
    uint256 public totalAmount;

    // مقدار ETH که دریافت‌کننده تاکنون برداشت کرده است
    uint256 public claimed;

    // مشخص می‌کند که آیا Vesting لغو شده است یا خیر
    bool public canceled;

    // مقدار دارایی آزادشده در لحظه لغو
    uint256 public vestedAtCancel;

    // متغیر محافظ برای جلوگیری از ورود مجدد به توابع حساس
    bool private locked;


    // =====================================================
    // 2. رویدادهای قرارداد
    // =====================================================

    // زمانی که دریافت‌کننده ETH برداشت می‌کند
    event Claimed(address indexed user, uint256 amount);

    // زمانی که مالک Vesting را لغو می‌کند
    event Canceled(uint256 vestedAmount, uint256 refundAmount);


    // =====================================================
    // 3. Modifierهای قرارداد
    // =====================================================

    // فقط مالک اجازه اجرای تابع را دارد
    modifier onlyOwner() {
        require(msg.sender == owner, "Not owner");
        _;
    }

    // فقط دریافت‌کننده اجازه اجرای تابع را دارد
    modifier onlyUser() {
        require(msg.sender == user, "Not user");
        _;
    }

    // جلوگیری از حمله Reentrancy
    modifier noReentry() {

        // بررسی می‌کنیم تابع از قبل در حال اجرا نباشد
        require(!locked, "Reentrancy");

        // قفل را فعال می‌کنیم
        locked = true;

        // اجرای کد اصلی تابع
        _;

        // بعد از پایان اجرای تابع، قفل را آزاد می‌کنیم
        locked = false;
    }


    // =====================================================
    // 4. Constructor
    // =====================================================

    // این تابع فقط یک بار هنگام Deploy اجرا می‌شود
    //
    // payable یعنی می‌توانیم هم‌زمان با Deploy کردن قرارداد،
    // مقدار ETH به آن ارسال کنیم.
    //
    // _user: آدرس دریافت‌کننده
    // _start: زمان شروع Vesting
    // _cliff: مدت زمان Cliff
    // _duration: کل مدت Vesting

    constructor(
        address _user,
        uint256 _start,
        uint256 _cliff,
        uint256 _duration
    ) payable {

        // بررسی معتبر بودن آدرس دریافت‌کننده
        require(_user != address(0), "Invalid user");

        // قرارداد باید هنگام Deploy مقداری ETH دریافت کند
        require(msg.value > 0, "No ETH sent");

        // مدت زمان Vesting نباید صفر باشد
        require(_duration > 0, "Invalid duration");

        // Cliff نباید بیشتر از کل مدت Vesting باشد
        require(_cliff <= _duration, "Invalid cliff");

        // زمان شروع نباید در گذشته باشد
        require(_start >= block.timestamp, "Invalid start");

        // ثبت آدرس سازنده به عنوان مالک
        owner = msg.sender;

        // ثبت آدرس دریافت‌کننده
        user = _user;

        // ذخیره زمان شروع
        start = _start;

        // ذخیره مدت Cliff
        cliff = _cliff;

        // ذخیره کل مدت Vesting
        duration = _duration;

        // ذخیره مقدار ETH دریافتی
        totalAmount = msg.value;
    }


    // =====================================================
    // 5. محاسبه زمان پایان Vesting
    // =====================================================

    // زمان پایان Vesting برابر است با:
    // زمان شروع + کل مدت Vesting

    function endTime() public view returns (uint256) {

        return start + duration;
    }


    // =====================================================
    // 6. محاسبه زمان پایان Cliff
    // =====================================================

    // تا قبل از این زمان، هیچ ETH قابل برداشتی نیست

    function cliffTime() public view returns (uint256) {

        return start + cliff;
    }


    // =====================================================
    // 7. محاسبه مقدار ETH آزادشده
    // =====================================================

    // این تابع محاسبه می‌کند که تا زمان فعلی چه مقدار
    // از کل دارایی طبق برنامه Vesting به دریافت‌کننده تعلق دارد.
    //
    // توجه:
    // آزاد شدن دارایی با برداشت آن متفاوت است.
    // ممکن است ETH آزاد شده باشد، اما هنوز برداشت نشده باشد.

    function vested() public view returns (uint256) {

        // اگر Vesting لغو شده باشد،
        // مقدار آزادشده دیگر افزایش پیدا نمی‌کند
        if (canceled) {
            return vestedAtCancel;
        }

        // اگر هنوز Cliff تمام نشده باشد،
        // هیچ مقداری آزاد نمی‌شود
        if (block.timestamp < cliffTime()) {
            return 0;
        }

        // اگر کل مدت Vesting تمام شده باشد،
        // تمام دارایی به دریافت‌کننده تعلق می‌گیرد
        if (block.timestamp >= endTime()) {
            return totalAmount;
        }

        // محاسبه مدت زمان سپری‌شده از شروع Vesting
        uint256 elapsed = block.timestamp - start;

        // محاسبه آزادسازی خطی
        //
        // مقدار کل ETH ضربدر زمان سپری‌شده
        // تقسیم بر کل مدت Vesting
        //
        // مثال:
        // اگر 50 درصد از زمان Vesting گذشته باشد،
        // 50 درصد از ETH آزاد می‌شود.

        return (totalAmount * elapsed) / duration;
    }


    // =====================================================
    // 8. محاسبه مقدار ETH قابل برداشت
    // =====================================================

    // این تابع مقدار ETH آزادشده‌ای را محاسبه می‌کند
    // که دریافت‌کننده هنوز آن را برداشت نکرده است.

    function available() public view returns (uint256) {

        // محاسبه مقدار کل ETH آزادشده
        uint256 amount = vested();

        // اگر تمام مقدار آزادشده قبلاً برداشت شده باشد،
        // چیزی برای برداشت باقی نمانده است
        if (amount <= claimed) {
            return 0;
        }

        // مقدار قابل برداشت = مقدار آزادشده - مقدار برداشت‌شده
        return amount - claimed;
    }


    // =====================================================
    // 9. برداشت ETH
    // =====================================================

    // فقط دریافت‌کننده می‌تواند ETH آزادشده را برداشت کند
    // از Modifier جلوگیری از Reentrancy نیز استفاده می‌کنیم.

    function claim()
        external
        onlyUser
        noReentry
    {

        // محاسبه مقدار قابل برداشت
        uint256 amount = available();

        // اگر چیزی برای برداشت وجود نداشته باشد،
        // تراکنش متوقف می‌شود
        require(amount > 0, "Nothing to claim");

        // ابتدا مقدار برداشت‌شده را به‌روزرسانی می‌کنیم
        // این کار باید قبل از انتقال ETH انجام شود
        claimed += amount;

        // انتقال ETH به دریافت‌کننده
        (bool success, ) = payable(user).call{value: amount}("");

        // بررسی موفقیت انتقال
        require(success, "Transfer failed");

        // ثبت رویداد برداشت
        emit Claimed(user, amount);
    }


    // =====================================================
    // 10. لغو Vesting
    // =====================================================

    // فقط مالک می‌تواند Vesting را لغو کند.
    //
    // در زمان لغو:
    // - مقدار آزادشده برای دریافت‌کننده حفظ می‌شود.
    // - مقدار آزاد‌نشده به مالک برگردانده می‌شود.
    // - پس از لغو، مقدار آزادشده دیگر افزایش پیدا نمی‌کند.

    function cancel()
        external
        onlyOwner
        noReentry
    {

        // بررسی می‌کنیم که قرارداد قبلاً لغو نشده باشد
        require(!canceled, "Already canceled");

        // محاسبه مقدار ETH تعلق‌گرفته به دریافت‌کننده
        uint256 amount = vested();

        // ذخیره مقدار آزادشده در لحظه لغو
        vestedAtCancel = amount;

        // ثبت وضعیت لغو
        canceled = true;

        // محاسبه مقدار آزاد‌نشده
        uint256 refund = totalAmount - amount;

        // اگر مبلغی باقی مانده باشد، به مالک برمی‌گردانیم
        if (refund > 0) {

            // انتقال ETH به مالک
            (bool success, ) = payable(owner).call{value: refund}("");

            // بررسی موفقیت انتقال
            require(success, "Refund failed");
        }

        // ثبت رویداد لغو قرارداد
        emit Canceled(amount, refund);
    }


    // =====================================================
    // 11. توابع مشاهده اطلاعات قرارداد
    // =====================================================

    // نمایش مجموع ETH برداشت‌شده
    function totalClaimed() external view returns (uint256) {

        return claimed;
    }

    // نمایش مقدار اختصاص‌یافته‌ای که هنوز برداشت نشده است
    // این مقدار لزوماً تماماً قابل برداشت نیست؛
    // بخشی از آن ممکن است هنوز Vest نشده باشد.
    function remaining() external view returns (uint256) {

        return totalAmount - claimed;
    }

    // نمایش موجودی فعلی ETH داخل قرارداد
    function balance() external view returns (uint256) {

        return address(this).balance;
    }

}
